{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/entgra/engineering-constitutions/main/schema/entgra-constitution.schema.json",
  "title": "Entgra Constitution Project Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constitution",
    "project",
    "modules",
    "project_instructions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release"],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "repository"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "$ref": "#/$defs/moduleList"
        },
        "optional": {
          "$ref": "#/$defs/moduleList"
        }
      }
    },
    "project_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^(universal|language|framework|platform|middleware)\\.[a-z0-9][a-z0-9-]*$"
    },
    "moduleList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleId"
      },
      "uniqueItems": true
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    }
  }
}
